use amm::math::fee_growth
use amm::math::sqrt_price_math
use amm::math::swap_math
use amm::math::tick_math
use miden::core::crypto::hashes::poseidon2
use miden::core::math::u64
use miden::core::math::u128
use miden::core::math::u256
use miden::protocol::account_id
use miden::protocol::active_account
use miden::protocol::active_note
use miden::protocol::asset
use miden::protocol::native_account
use miden::protocol::note
use miden::protocol::output_note
use miden::protocol::tx

# Hand-written MASM port of the clamm-pool account component (DESIGN.md Part 2 storage
# layout and note flows, Part 3 number formats), Stage 2 of the MASM port.
#
# Unlike the Rust-SDK build (whose compiler could not run the memory-writing
# active-note reads from account context), every exported procedure here takes NO
# arguments: note storage, note assets, the note sender, and the note serial number are
# all read through the kernel (`active_note::*`) from inside the account code, so
# nothing is trusted from the calling note script. Note storage layouts are
# byte-identical to the Rust production notes, and a committed pool state produced by
# this component is indistinguishable from the Rust component's for the same
# operations (same slot names, same packings, same Poseidon2 position keys, same P2ID
# serial scheme).
#
# Number formats (DESIGN Part 3):
# - sqrtPriceX96: u128 as 4 little-endian u32 limbs in one Word.
# - liquidity: u128, same packing; liquidityNet: i128 two's-complement bit pattern.
# - fee growth accumulators: Q128.128 in u256 = two Words (lo/hi).
# - ticks offset-encoded as tick + 2^19 so all stored ticks are natural numbers.

# CONSTANTS
# =================================================================================================

# Storage slots. The slot names are identical to the Rust-SDK component's
# (`clamm_pool::clamm_pool::<field>`) so the MockChain testbed reads both backends
# through the same slot names.
const POOL_CONFIG_SLOT = word("clamm_pool::clamm_pool::pool_config")
const POOL_PARAMS_SLOT = word("clamm_pool::clamm_pool::pool_params")
const P2ID_ROOT_SLOT = word("clamm_pool::clamm_pool::p2id_root")
const SQRT_PRICE_SLOT = word("clamm_pool::clamm_pool::sqrt_price")
const POOL_STATE_SLOT = word("clamm_pool::clamm_pool::pool_state")
const LIQUIDITY_SLOT = word("clamm_pool::clamm_pool::liquidity")
const FG0_LO_SLOT = word("clamm_pool::clamm_pool::fee_growth_global0_lo")
const FG0_HI_SLOT = word("clamm_pool::clamm_pool::fee_growth_global0_hi")
const FG1_LO_SLOT = word("clamm_pool::clamm_pool::fee_growth_global1_lo")
const FG1_HI_SLOT = word("clamm_pool::clamm_pool::fee_growth_global1_hi")
const TICKS_SLOT = word("clamm_pool::clamm_pool::ticks")
const TICK_BITMAP_SLOT = word("clamm_pool::clamm_pool::tick_bitmap")
const POSITIONS_SLOT = word("clamm_pool::clamm_pool::positions")

# Tick encoding (DESIGN Part 2): stored tick = tick + 2^19.
const TICK_OFFSET = 524288
const MAX_TICK_OFF_ENCODED = 1048576    # 2 * TICK_OFFSET, upper bound of the encoding
const OFF_MIN_TICK = 80652              # MIN_TICK (-443636) offset-encoded
const OFF_MAX_TICK = 967924             # MAX_TICK (+443636) offset-encoded

# Bias making compressed-tick -> tick conversion non-negative on felts:
# biased_tick = c_off * spacing + (TICK_BIAS - TICK_OFFSET * spacing).
const TICK_BIAS = 1152921504606846976        # 2^60
const BIASED_MIN_TICK = 1152921504606403340  # TICK_BIAS + MIN_TICK
const BIASED_MAX_TICK = 1152921504607290612  # TICK_BIAS + MAX_TICK
const BIAS_MINUS_OFFSET = 1152921504606322688 # TICK_BIAS - TICK_OFFSET

# Hard bound on swap-loop iterations (DESIGN divergence 8; same as the Rust build).
const MAX_SWAP_ITERATIONS = 16

# Domain tag mixed into the Poseidon2 position-key hash ("POS1").
const POSITION_DOMAIN = 0x504F5331

# Field ids of the striped position record (DESIGN Part 2).
const POS_LIQUIDITY = 0
const POS_FG0_LO = 1
const POS_FG0_HI = 2
const POS_FG1_LO = 3
const POS_FG1_HI = 4
const POS_TOKENS_OWED = 5

# Field groups of the striped tick record (DESIGN Part 2).
const TICK_LIQ_GROSS = 0
const TICK_LIQ_NET = 1
const TICK_FG0_LO = 2
const TICK_FG0_HI = 3
const TICK_FG1_LO = 4
const TICK_FG1_HI = 5
const TICK_NUM_GROUPS = 6

# Serial-derivation salts for P2ID output notes (same scheme as the Rust pool).
const SALT_SWAP_OUT = 0
const SALT_SWAP_REFUND = 1
const SALT_MINT_REFUND = 2
const SALT_COLLECT = 3

# P2ID output note parameters (tag 0, public storage mode).
const P2ID_NOTE_TAG = 0
const NOTE_TYPE_PUBLIC = 1

# Sqrt price domain (Q64.96 in u128), same values as amm::math::tick_math.
const MIN_SQRT_L0 = 0x4EA15D28
const MIN_SQRT_L1 = 0x00013B50
const MIN_SQRT_L2 = 0x00000001
const MIN_SQRT_L3 = 0x00000000
const MAX_SQRT_L0 = 0xFB40724A
const MAX_SQRT_L1 = 0xA81B33B5
const MAX_SQRT_L2 = 0x35BB7F32
const MAX_SQRT_L3 = 0xFFFEC4B1

# Goldilocks modulus limbs, for u64 -> felt range assertions.
const FELT_MOD_LO = 1
const FELT_MOD_HI = 0xFFFFFFFF
const MAX_U32 = 0x100000000

# Shared note storage item indices (all four note layouts start with the pool id).
const ST_POOL_ID_SUFFIX = 0
const ST_POOL_ID_PREFIX = 1

# Swap note storage items (8 felts, byte-identical to the Rust production note).
const SWAP_ST_DIRECTION = 2
const SWAP_ST_MIN_OUT_LO = 3
const SWAP_ST_MIN_OUT_HI = 4
const SWAP_ST_RECIPIENT_SUFFIX = 5
const SWAP_ST_RECIPIENT_PREFIX = 6
