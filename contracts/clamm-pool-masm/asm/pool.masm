const SW_TICK = 83          # current tick (offset-encoded)
const SW_ITER = 84          # loop iteration counter
const SW_NEEDS_REV = 85     # reverse-tick-mapping flag
const SW_NEXT_TICK = 86     # per-step next initialized tick
const SW_NEXT_INIT = 87     # per-step initialized flag
const SW_REACHED = 88       # per-step target-reached flag

