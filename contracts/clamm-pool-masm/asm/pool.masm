# Collect note storage items (4 felts).
const COLLECT_ST_TICK_LOWER = 2
const COLLECT_ST_TICK_UPPER = 3

# swap memory locals
const SW_STORAGE = 0        # 8 note storage felts (0..7)
const SW_ASSET_KEY = 8      # input asset KEY (8..11)
const SW_ASSET_VALUE = 12   # input asset VALUE (12..15)
const SW_ASSET_AMOUNT = 12  # fungible amount = VALUE limb 0
const SW_SCRATCH_KEY = 16   # expected/output asset KEY (16..19)
const SW_SCRATCH_VALUE = 20 # expected/output asset VALUE (20..23)
const SW_SQRT = 24          # current sqrt price (24..27)
const SW_LIQ = 28           # active liquidity (28..31)
const SW_REMAINING = 32     # unconsumed input (32..35)
const SW_OUT_TOTAL = 36     # accumulated output (36..39)
const SW_FG_IN_LO = 40      # in-direction fee growth accumulator, low word (40..43)
const SW_FG_IN_HI = 44      # high word (44..47)
const SW_MIN_OUT = 48       # minimum acceptable output (48..51)
const SW_LIMIT = 52         # price limit for the swap direction (52..55)
const SW_TARGET = 56        # per-step target price (56..59)
const SW_NEXT = 60          # per-step end price (60..63)
const SW_STEP_IN = 64       # per-step amount in (64..67)
const SW_STEP_OUT = 68      # per-step amount out (68..71)
const SW_STEP_FEE = 72      # per-step fee (72..75)
