use miden::protocol::account_id
use miden::protocol::active_account
use miden::protocol::active_note
use miden::protocol::tx
use miden::standards::wallets::basic->wallet
use clamm::pool

# AMM swap note (MASM port of contracts/amm-note-swap): a thin P2IDE-style two-path
# dispatcher. Note storage layout (8 felts, byte-identical to the Rust note):
# [pool_id_suffix, pool_id_prefix, direction, min_out_lo, min_out_hi,
#  recipient_suffix, recipient_prefix, deadline_height].
#
# - Path A (executing account == pool_id from note storage): `call` the pool's
#   `swap` procedure with NO arguments — the pool reads note storage, assets, and
#   the sender through the kernel.
# - Path B (executing account == note sender, block >= deadline): reclaim the note
#   assets into the sender's wallet via the STANDARD miden-standards BasicWallet
#   `receive_asset` (through `basic::add_assets_to_account`, the p2ide.masm path),
#   so any standard-wallet sender can reclaim.
# - Anyone else: panic.

# CONSTANTS
# =================================================================================================

const STORAGE_PTR = 0
const POOL_ID_SUFFIX_ITEM = 0
const POOL_ID_PREFIX_ITEM = 1
const DEADLINE_ITEM = 7
const NUM_STORAGE_ITEMS = 8

# ERRORS
# =================================================================================================

const ERR_SWAP_NOTE_BAD_STORAGE = "AMM swap note expects exactly 8 note storage items"
const ERR_SWAP_NOTE_UNAUTHORIZED = "AMM swap note: wrong pool or unauthorized consumer"
const ERR_SWAP_NOTE_RECLAIM_EARLY = "AMM swap note: reclaim before deadline"

# PROCEDURES
# =================================================================================================

#! AMM swap note script: dispatches to the pool's kernel-read `swap` procedure when
#! consumed by the pool, or reclaims the assets to the sender's standard BasicWallet
#! at/after the deadline.
#!
#! Inputs:  []
#! Outputs: []
#!
#! Panics if:
#! - the note storage does not hold exactly 8 items.
#! - the consumer is neither the targeted pool nor the note sender.
#! - the sender reclaims before the deadline height.
@note_script
pub proc main
    # load the note storage to memory starting at address 0
    push.STORAGE_PTR exec.active_note::get_storage
    eq.NUM_STORAGE_ITEMS assert.err=ERR_SWAP_NOTE_BAD_STORAGE

    # Path selection: is the executing account the pool named in note storage?
    mem_load.POOL_ID_PREFIX_ITEM mem_load.POOL_ID_SUFFIX_ITEM
    exec.active_account::get_id
    exec.account_id::is_equal
    if.true
        # Path A: the pool executes; everything is kernel-read inside the pool
        padw padw padw padw
        call.pool::swap
        dropw dropw dropw dropw
    else
        # Path B: sender reclaim, only at/after the deadline
        exec.active_note::get_sender
        exec.active_account::get_id
        exec.account_id::is_equal assert.err=ERR_SWAP_NOTE_UNAUTHORIZED
        mem_load.DEADLINE_ITEM
        exec.tx::get_block_number
        lte assert.err=ERR_SWAP_NOTE_RECLAIM_EARLY
        exec.wallet::add_assets_to_account
    end
end
