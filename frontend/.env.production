# Production build → public Miden testnet.
#
# "testnet" resolves inside the SDK to:
#   rpc:    https://rpc.testnet.miden.io       (gRPC-web + CORS, verified)
#   prover: https://tx-prover.testnet.miden.io (delegated proving, CORS verified)
VITE_MIDEN_RPC_URL=testnet
VITE_MIDEN_PROVER=testnet

# The committed public-testnet CLAMM deployment descriptor (written by
# `cargo run -p integration --bin export_web_artifacts --release -- --deploy --network testnet`).
# Local dev keeps the default /packages/clamm/deployment.json (gitignored,
# written by the local-stack --deploy run).
VITE_CLAMM_DEPLOYMENT_URL=/packages/clamm/deployment.testnet.json

# Measured 2026-08-27 (testnet_smoke): the public testnet operator does not
# run an ntx-builder that services arbitrary network accounts — a committed
# mint note against the deployed pool was never consumed (600s+ observation).
# This shows the persistent "notes will sit pending / reclaim after deadline"
# notice on the note-submitting flows. Remove once testnet services the pool.
VITE_CLAMM_NTX_PASSIVE=1
